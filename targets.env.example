# kodi-drive targets — copy to ~/.config/kodi-drive/targets.env and chmod 600.
#
#   mkdir -p ~/.config/kodi-drive && chmod 700 ~/.config/kodi-drive
#   cp targets.env.example ~/.config/kodi-drive/targets.env
#   chmod 600 ~/.config/kodi-drive/targets.env
#
# This file exists so no host, port, or credential ever appears in a repo, a
# CLAUDE.md, or an agent's terminal output. Skills refer only to $KODI_TARGET.
#
# NEVER `cat` this file. Agent session transcripts record everything printed to
# the terminal, and transcripts are not scrubbed.
#
# Variables are KODI_<TARGET>_<KEY>, with the target name upper-cased and
# hyphens turned into underscores: target "living-room" -> KODI_LIVING_ROOM_*.
#
# Keys:
#   TRANSPORT  http | ssh | adb        how to reach it
#   HOST       hostname or IP          for JSON-RPC and the EventServer
#   PORT       JSON-RPC port           Kodi's default is 8080
#   USER PASS  JSON-RPC credentials    only if "Require authentication" is on
#   ESPORT     EventServer UDP port    Kodi's default is 9777
#   ADDR       host:port or user@host  for adb / ssh transports
#   LOG        path to kodi.log        as seen from THIS machine
#   SHOTS      screenshot directory    as seen from THIS machine
#
# Select a target per command with KODI_TARGET=name, or set the default below.

KODI_TARGET_DEFAULT=devbox


# --- a Kodi on this machine ----------------------------------------------
# Turn the API on first: Settings > Services > Control >
# "Allow remote control via HTTP". It is OFF by default.
# For kodi-builtin, also enable "Allow programs on other systems to control Kodi".

KODI_DEVBOX_TRANSPORT=http
KODI_DEVBOX_HOST=127.0.0.1
KODI_DEVBOX_PORT=8080
KODI_DEVBOX_USER=kodi
KODI_DEVBOX_PASS=changeme
KODI_DEVBOX_ESPORT=9777
KODI_DEVBOX_LOG=$HOME/.kodi/temp/kodi.log


# --- an Android TV box over ADB ------------------------------------------
# Find it with the kodi-connect skill rather than guessing the address —
# Android 11+ assigns a *rotating* wireless-debugging port, so a hardcoded
# one goes stale on every reboot.

# KODI_TV_TRANSPORT=adb
# KODI_TV_ADDR=192.0.2.10:5555
# KODI_TV_HOST=192.0.2.10
# KODI_TV_PORT=8080
# KODI_TV_USER=kodi
# KODI_TV_PASS=changeme


# --- a Raspberry Pi or server over SSH -----------------------------------

# KODI_PI_TRANSPORT=ssh
# KODI_PI_ADDR=pi@192.0.2.20
# KODI_PI_HOST=192.0.2.20
# KODI_PI_PORT=8080
# KODI_PI_LOG=/home/pi/.kodi/temp/kodi.log


# --- servers Kodi talks to -----------------------------------------------
# Same rules: keep them here, not in a repo.

# JELLYFIN_URL=https://media.example.com
# JELLYFIN_API_KEY=
# AUDIOBOOKSHELF_URL=https://books.example.com
# AUDIOBOOKSHELF_TOKEN=
